# ───── Base de Datos PostgreSQL (requerido) ─────
# Formato: postgresql://usuario:contraseña@host:puerto/base_de_datos
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/attendancesoft

# ───── Auth ─────
# Secreto para firmar cookies de sesión (requerido en producción).
# Generar con: openssl rand -base64 32
AUTH_SECRET=zfiTUXsXm6QQ4bw20qh249cIXjLhFSJEf3DEEUPtFTg=

# ───── API (servidor Elysia) ─────
NODE_ENV=development
PORT=3001
HOST=localhost

# URL pública del frontend, usada por el API para construir links
# (p.ej. el de recuperación de contraseña).
WEB_URL=http://localhost:3000

# ───── Web (TanStack Start) ─────
# URL pública del API. Se inyecta en el bundle del cliente — cualquier
# variable con prefijo PUBLIC_ o VITE_ es visible desde el navegador.
PUBLIC_API_URL=http://localhost:3001
