# Mobile (Capacitor) environment.
# Copy to `.env.local` and adjust if your API runs on a different host.
#
# Important:
# - On the iOS simulator, "localhost" is the host's localhost — works
#   out of the box.
# - On the Android emulator, "localhost" maps to the EMULATOR itself.
#   Use 10.0.2.2 to reach the host's localhost: PUBLIC_API_URL=http://10.0.2.2:3001
# - On a physical device, use your computer's LAN IP (192.168.x.y).
# - For production builds: set PUBLIC_API_URL to the deployed API URL.

PUBLIC_API_URL=http://localhost:3001
